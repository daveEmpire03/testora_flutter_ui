{
  "name": "cloudflare-api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "db:create": "wrangler d1 create testora-db",
    "db:migrate:local": "wrangler d1 migrations apply testora-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply testora-db --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.3",
    "@types/node": "^26.6.6",
    "typescript": "^5.5.2",
    "vitest": "~5.0.3",
    "wrangler": "^4.156.0"
  },
  "dependencies": {
    "hono": "^4.13.14"
  }
}
