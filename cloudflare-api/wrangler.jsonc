{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "testora-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "vars": {
    "APP_ENV": "development",
    "FIREBASE_PROJECT_ID": "testora-pays",
    "ALLOWED_ORIGINS": "http://localhost:7357,http://127.0.0.1:7357,https://testora-web.pages.dev,https://97efd548.testora-web.pages.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "testora-db",
      "database_id": "1449f8b9-f057-4a9d-acba-d69c9141aee5",
      "migrations_dir": "migrations"
    }
  ]
}
